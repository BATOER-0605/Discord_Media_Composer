# Discord Media Composer 設定例
# このファイルは「任意」です。すべての変数にコード側の既定値があるため、
# .env を作成しなくても `docker compose up -d` だけで動作します。
# 値を上書きしたい場合のみ、このファイルを .env にコピーして編集してください。

# 待受ポート / バインドアドレス（既定で全 IP からアクセス可）
PORT=3000
HOST=0.0.0.0

# Cookie 署名鍵。空のままなら起動時にランダム生成されます。
SESSION_SECRET=

# 目標ファイルサイズ（MB）。Discord の 10MB から安全マージンを取った値。
TARGET_MB=9.5

# 受け付けるアップロードの最大サイズ（MB）
MAX_UPLOAD_MB=2000

# 音声ビットレート（kbps）
AUDIO_BITRATE_K=128

# これを下回る動画ビットレートになる場合は解像度を下げる（kbps）
MIN_VIDEO_BITRATE_K=145

# x264 のプリセット（ultrafast..veryslow）
X264_PRESET=medium

# セッション終了とみなすまでの猶予期間（分）。
# 切断後この時間内に再アクセスすれば処理に再アタッチできます。
GRACE_PERIOD_MINUTES=5

# 同時に走らせる圧縮ジョブ数（CPU 過負荷防止）
MAX_CONCURRENT_JOBS=2

# 対応形式（カンマ区切りの MIME タイプ）
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/heic,image/heif,image/webp
ALLOWED_VIDEO_MIME=video/mp4,video/quicktime,video/x-matroska,video/webm,video/3gpp
